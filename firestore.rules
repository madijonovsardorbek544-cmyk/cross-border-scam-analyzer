rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    match /reports/{reportId} {
      allow create: if request.resource.data.keys().hasOnly([
          'redactedMessage', 'language', 'countryRegion', 'platform', 'context',
          'riskLevel', 'score', 'source', 'createdAt', 'status', 'redactionSummary'
        ])
        && request.resource.data.redactedMessage is string
        && request.resource.data.redactedMessage.size() <= 5000
        && request.resource.data.status == 'new';
      allow read, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
      match /localOptInChecks/{checkId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /institutionSummaries/{summaryId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
